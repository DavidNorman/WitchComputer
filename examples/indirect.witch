; Symbolic address names

LOAD_STORE_ADDRESS = 93
LOAD_STORE_DATA = 94
LOAD_PROGRAM = 95
STORE_PROGRAM = 97

; Useful routines for indirect loading and storing

; There are 2 in-store programs, one for load and one for store.
; Each takes the address in store 93 and the data is read or
; written out of store 94.  To activate the indirect load/store
; you search for block #1 (load) or block #2 (store) on the
; special stored routine tape (tape 3 here) and transfer execution
; there. When complete, control will be transferred back to tape 2.

; The programs require the block of memory between 90-99 to contain
; the in-store code.

; Variables
; 93 - address for load/store
; 94 - data for load/store
; 95 - the beginning of the load program
; 97 - the beginning of the store program

; tape 1
==tape

#1

; Clear program space

CLEAR LOAD_STORE_ADDRESS
CLEAR LOAD_STORE_DATA
CLEAR LOAD_PROGRAM
CLEAR 96
CLEAR STORE_PROGRAM
CLEAR 98
CLEAR 99

; Setup indirect load operation

; 1xx09: store source -> 09
ADD 01 LOAD_PROGRAM
ADD 00 LOAD_STORE_DATA

; 02102: return to main program
ADD 01 96
TRANSFER-CONTROL 02

; Setup indirect store operation

; 2xx00: clear destination
ADD 01 STORE_PROGRAM
CLEAR 00

; 109xx: store 94 -> destination (clear 94)
ADD 01 98
CLEAR LOAD_STORE_DATA

; 02102: return to main program
ADD 01 99
TRANSFER-CONTROL 02


; Transfer to main tape
SEARCH 1 02
TRANSFER-CONTROL 02


; tape 2
==tape

#1

; Set up some dummy data
CLEAR 20
ADD 02 20
+00000006
CLEAR 21
ADD 02 21
+00000060

; Set up indirect load from 20
CLEAR LOAD_STORE_ADDRESS
ADD 02 LOAD_STORE_ADDRESS
+00000020

; Call indirect load
SEARCH 1 07
TRANSFER-CONTROL 07

; Print loaded value
PRINT-LAYOUT-2
ADD LOAD_STORE_DATA 01

; Set up indirect load from 21
CLEAR LOAD_STORE_ADDRESS
ADD 02 LOAD_STORE_ADDRESS
+00000021

; Call indirect load
SEARCH 1 07
TRANSFER-CONTROL 07

; Print loaded value
PRINT-LAYOUT-2
ADD LOAD_STORE_DATA 01

; Load some dummy data to 94
CLEAR LOAD_STORE_DATA
ADD 02 LOAD_STORE_DATA
+12345678

; Setup indirect store to 22
CLEAR LOAD_STORE_ADDRESS
ADD 02 LOAD_STORE_ADDRESS
+00000022

; Call indirect store
SEARCH 2 07
TRANSFER-CONTROL 07

; Print 22
ADD 22 01

; Stop
FINISH


; tape 3
==tape
FINISH


; tape 4
==tape
FINISH


; tape 5
==tape
FINISH


; tape 6
==tape
FINISH


; tape 7
==tape

; Indirect load entry
; inputs:
;   93 contains dst address
; outputs:
;   94 contains data
;   93 is unchanged
;   09 is modified
#1

; Clear store instruction and add basic opcode back in
CLEAR LOAD_PROGRAM
ADD 07 LOAD_PROGRAM
ADD 00 LOAD_STORE_DATA

; Add in source by shifting via 09
CLEAR 09
SHIFT -3
ADD LOAD_STORE_ADDRESS 09
ADD-AND-CLEAR 08 LOAD_PROGRAM

; Clear the destination data
CLEAR LOAD_STORE_DATA

; Call in-store code
TRANSFER-CONTROL LOAD_PROGRAM

; Indirect store entry
; inputs:
;   93 contains dst address
;   94 contains data
; outputs:
;   93 is unchanged
;   94 is unchanged
;   09 is modified
#2

; Set up clear and move opcodes
CLEAR STORE_PROGRAM
ADD 07 STORE_PROGRAM
CLEAR 00

CLEAR 98
ADD 07 98
CLEAR LOAD_STORE_DATA

; Add in clear opcode address
CLEAR 09
SHIFT -3
ADD LOAD_STORE_ADDRESS 09
ADD 08 STORE_PROGRAM

; Add in move opcode address
CLEAR 09
SHIFT -5
ADD LOAD_STORE_ADDRESS 09
ADD 08 98

; Call in-store code
TRANSFER-CONTROL STORE_PROGRAM
