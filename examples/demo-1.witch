; Symbolic address names

X = 10
INCREMENT = 20
LIMIT = 30
TEMP = 40

; Demonstration program 1

; Computes the squares for X=1.0, 1.1, 1.2, 1.3, 1.4, 1.5

; http://www.computerconservationsociety.org/witch4.htm

==tape

#1

; Clear stores
CLEAR 09
CLEAR X
CLEAR INCREMENT
CLEAR LIMIT
CLEAR TEMP

; Add in data
ADD 01 X
+10000000
ADD 01 INCREMENT
+01000000
ADD 01 LIMIT
+15500000

; Transfer to other tape
SEARCH 2 02
TRANSFER-CONTROL 02


==tape

#2

; Calc X, X^2
ADD X TEMP
MULTIPLY X TEMP

; Print
PRINT-LAYOUT-1
ADD X 01
PRINT-LAYOUT-2
ADD 09 01

; Increase X
ADD INCREMENT X

; Test
ADD LIMIT TEMP
SUBTRACT X TEMP
TEST-POSITIVE TEMP

CLEAR TEMP
CLEAR 09

; Search for block 2 again or stop
SEARCH-IF 2 02
FINISH
