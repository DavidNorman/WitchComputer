; Euclidean greatest common divisor by repeated subtraction.
; Calculates gcd(4.8, 1.8) = 0.6.

A = 10
B = 20
DIFFERENCE = 40
MAGNITUDE = 50
EPSILON = 60

==tape

#1

CLEAR 09
CLEAR A
CLEAR B
CLEAR DIFFERENCE
CLEAR MAGNITUDE
CLEAR EPSILON

ADD 01 A
+48000000
ADD 01 B
+18000000
ADD 01 EPSILON
+00000001

SEARCH 2 02
TRANSFER-CONTROL 02

==tape

#2

; DIFFERENCE = A - B
CLEAR DIFFERENCE
ADD A DIFFERENCE
SUBTRACT B DIFFERENCE

; Use positive modulus so the machine's negative zero compares as zero
CLEAR MAGNITUDE
TRANSFER-POSITIVE-MODULUS DIFFERENCE MAGNITUDE
SUBTRACT EPSILON MAGNITUDE
TEST-NEGATIVE MAGNITUDE
SEARCH-IF 4 02
TRANSFER-CONTROL-IF 02

; If A-B is negative, replace B with B-A
TEST-NEGATIVE DIFFERENCE
SEARCH-IF 3 02
TRANSFER-CONTROL-IF 02

; A was larger, so A = A-B
CLEAR A
ADD DIFFERENCE A
SEARCH 2 02

#3

; B was larger, so B = B-A
CLEAR DIFFERENCE
ADD B DIFFERENCE
SUBTRACT A DIFFERENCE
CLEAR B
ADD DIFFERENCE B
SEARCH 2 02

#4

PRINT-LAYOUT-2
ADD A 01
FINISH
