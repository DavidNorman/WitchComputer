; Evaluate 2x^3 - 3x^2 + 4x - 5 at x = 1.2 using Horner's rule:
;
;   ((2x - 3)x + 4)x - 5 = -1.064

X = 10
X_COPY = 20
RESULT = 30
COEFFICIENT = 40

==tape

#1

CLEAR 09
CLEAR X
CLEAR X_COPY
CLEAR RESULT
CLEAR COEFFICIENT

; x = 1.2 and leading coefficient = 2
ADD 01 X
+12000000
ADD 01 RESULT
+20000000

; result = result*x - 3
ADD X X_COPY
MULTIPLY RESULT X_COPY
CLEAR RESULT
ADD-AND-CLEAR 09 RESULT
ADD 01 COEFFICIENT
-30000000
ADD-AND-CLEAR COEFFICIENT RESULT

; result = result*x + 4
ADD X X_COPY
MULTIPLY RESULT X_COPY
CLEAR RESULT
ADD-AND-CLEAR 09 RESULT
ADD 01 COEFFICIENT
+40000000
ADD-AND-CLEAR COEFFICIENT RESULT

; result = result*x - 5
ADD X X_COPY
MULTIPLY RESULT X_COPY
CLEAR RESULT
ADD-AND-CLEAR 09 RESULT
ADD 01 COEFFICIENT
-50000000
ADD-AND-CLEAR COEFFICIENT RESULT

PRINT-LAYOUT-2
ADD RESULT 01
FINISH
