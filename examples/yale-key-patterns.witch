; Enumerate every six-position bitting for a standard Yale .019-inch system.
;
; Each position ranges from depth 0 through 9. A pattern is within the
; manufacturer's mechanical specification when every adjacent pair differs by
; at most 5 (MACS 5). This program counts patterns; it does not print every
; accepted pattern, because that would produce 367826 lines.
;
; Counts use the least-significant store digit as one:
;   RAW_COUNT       finishes at 0.1000000 = 1000000
;   VALID_COUNT     finishes at 0.0367826 =  367826
;   REJECTED_COUNT  finishes at 0.0632174 =  632174
;
; The result describes mechanical bitting validity, not the security of a lock.

DEPTH_1 = 10
REMAINING_1 = 11

DEPTH_2 = 20
REMAINING_2 = 21

DEPTH_3 = 30
REMAINING_3 = 31

DEPTH_4 = 40
REMAINING_4 = 41

DEPTH_5 = 50
REMAINING_5 = 51

DEPTH_6 = 60
REMAINING_6 = 61

MACS_PLUS_ONE = 70
MAGNITUDE = 80

RAW_COUNT = 90
VALID_COUNT = 91
REJECTED_COUNT = 92


; Tape 1: initialise constants and counters.
==tape

#1

CLEAR DEPTH_1
CLEAR REMAINING_1
CLEAR DEPTH_2
CLEAR REMAINING_2
CLEAR DEPTH_3
CLEAR REMAINING_3
CLEAR DEPTH_4
CLEAR REMAINING_4
CLEAR DEPTH_5
CLEAR REMAINING_5
CLEAR DEPTH_6
CLEAR REMAINING_6

CLEAR MACS_PLUS_ONE
ADD 01 MACS_PLUS_ONE
+00000006

CLEAR MAGNITUDE
CLEAR RAW_COUNT
CLEAR VALID_COUNT
CLEAR REJECTED_COUNT

SEARCH 1 02
TRANSFER-CONTROL 02


; Tape 2: six nested decimal loops.
==tape

; Initialise the outermost digit.
#1
CLEAR DEPTH_1
CLEAR REMAINING_1
ADD 02 REMAINING_1
+00000010

; Each inner-loop entry resets its digit to 0 and gives it ten iterations.
#2
CLEAR DEPTH_2
CLEAR REMAINING_2
ADD 02 REMAINING_2
+00000010

#3
CLEAR DEPTH_3
CLEAR REMAINING_3
ADD 02 REMAINING_3
+00000010

#4
CLEAR DEPTH_4
CLEAR REMAINING_4
ADD 02 REMAINING_4
+00000010

#5
CLEAR DEPTH_5
CLEAR REMAINING_5
ADD 02 REMAINING_5
+00000010

#6
CLEAR DEPTH_6
CLEAR REMAINING_6
ADD 02 REMAINING_6
+00000010


; Validate all five adjacent pairs.
;
; For each pair:
;   MAGNITUDE = abs(left - right)
;   accumulator = 6 - MAGNITUDE
;
; A magnitude of 6 gives negative zero, and larger magnitudes are negative.
; Either case is outside MACS 5 and branches to block 8.
#7

; DEPTH_1, DEPTH_2
CLEAR 09
ADD DEPTH_1 09
SUBTRACT DEPTH_2 09
CLEAR MAGNITUDE
TRANSFER-POSITIVE-MODULUS 09 MAGNITUDE
CLEAR 09
ADD MACS_PLUS_ONE 09
SUBTRACT MAGNITUDE 09
TEST-NEGATIVE 09
SEARCH-IF 8 02
TRANSFER-CONTROL-IF 02

; DEPTH_2, DEPTH_3
CLEAR 09
ADD DEPTH_2 09
SUBTRACT DEPTH_3 09
CLEAR MAGNITUDE
TRANSFER-POSITIVE-MODULUS 09 MAGNITUDE
CLEAR 09
ADD MACS_PLUS_ONE 09
SUBTRACT MAGNITUDE 09
TEST-NEGATIVE 09
SEARCH-IF 8 02
TRANSFER-CONTROL-IF 02

; DEPTH_3, DEPTH_4
CLEAR 09
ADD DEPTH_3 09
SUBTRACT DEPTH_4 09
CLEAR MAGNITUDE
TRANSFER-POSITIVE-MODULUS 09 MAGNITUDE
CLEAR 09
ADD MACS_PLUS_ONE 09
SUBTRACT MAGNITUDE 09
TEST-NEGATIVE 09
SEARCH-IF 8 02
TRANSFER-CONTROL-IF 02

; DEPTH_4, DEPTH_5
CLEAR 09
ADD DEPTH_4 09
SUBTRACT DEPTH_5 09
CLEAR MAGNITUDE
TRANSFER-POSITIVE-MODULUS 09 MAGNITUDE
CLEAR 09
ADD MACS_PLUS_ONE 09
SUBTRACT MAGNITUDE 09
TEST-NEGATIVE 09
SEARCH-IF 8 02
TRANSFER-CONTROL-IF 02

; DEPTH_5, DEPTH_6
CLEAR 09
ADD DEPTH_5 09
SUBTRACT DEPTH_6 09
CLEAR MAGNITUDE
TRANSFER-POSITIVE-MODULUS 09 MAGNITUDE
CLEAR 09
ADD MACS_PLUS_ONE 09
SUBTRACT MAGNITUDE 09
TEST-NEGATIVE 09
SEARCH-IF 8 02
TRANSFER-CONTROL-IF 02

; All five pairs passed.
ADD 02 VALID_COUNT
+00000001
SEARCH 9 02
TRANSFER-CONTROL 02


; At least one pair failed.
#8
ADD 02 REJECTED_COUNT
+00000001


; Count the pattern, then advance the base-ten odometer from right to left.
#9
ADD 02 RAW_COUNT
+00000001

ADD 02 DEPTH_6
+00000001
SUBTRACT 02 REMAINING_6
+00000001
TEST-POSITIVE REMAINING_6
SEARCH-IF 7 02
TRANSFER-CONTROL-IF 02

ADD 02 DEPTH_5
+00000001
SUBTRACT 02 REMAINING_5
+00000001
TEST-POSITIVE REMAINING_5
SEARCH-IF 6 02
TRANSFER-CONTROL-IF 02

ADD 02 DEPTH_4
+00000001
SUBTRACT 02 REMAINING_4
+00000001
TEST-POSITIVE REMAINING_4
SEARCH-IF 5 02
TRANSFER-CONTROL-IF 02

ADD 02 DEPTH_3
+00000001
SUBTRACT 02 REMAINING_3
+00000001
TEST-POSITIVE REMAINING_3
SEARCH-IF 4 02
TRANSFER-CONTROL-IF 02

ADD 02 DEPTH_2
+00000001
SUBTRACT 02 REMAINING_2
+00000001
TEST-POSITIVE REMAINING_2
SEARCH-IF 3 02
TRANSFER-CONTROL-IF 02

ADD 02 DEPTH_1
+00000001
SUBTRACT 02 REMAINING_1
+00000001
TEST-POSITIVE REMAINING_1
SEARCH-IF 2 02
TRANSFER-CONTROL-IF 02


; Print raw, within-spec, and outside-spec counts, in that order.
#0
PRINT-LAYOUT-2
ADD RAW_COUNT 01
ADD VALID_COUNT 01
ADD REJECTED_COUNT 01
FINISH
