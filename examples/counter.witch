; Count from 0 to 9 and print each value.

COUNTER = 10
ONE = 20
LIMIT = 30
TEMP = 40
MAGNITUDE = 50
EPSILON = 60

==tape

#1

CLEAR COUNTER
CLEAR ONE
CLEAR LIMIT
CLEAR TEMP
CLEAR MAGNITUDE
CLEAR EPSILON

ADD 01 ONE
+10000000
ADD 01 LIMIT
+90000000
ADD 01 EPSILON
+00000001

SEARCH 2 02
TRANSFER-CONTROL 02

==tape

#2

PRINT-LAYOUT-2
ADD COUNTER 01

; Stop when COUNTER equals LIMIT. Positive modulus handles negative zero.
CLEAR TEMP
ADD COUNTER TEMP
SUBTRACT LIMIT TEMP
CLEAR MAGNITUDE
TRANSFER-POSITIVE-MODULUS TEMP MAGNITUDE
SUBTRACT EPSILON MAGNITUDE
TEST-NEGATIVE MAGNITUDE
SEARCH-IF 4 02
TRANSFER-CONTROL-IF 02

#3

ADD ONE COUNTER
SEARCH 2 02

#4

FINISH
