; Symbolic address names

X = 10
INCREMENT = 20
LIMIT = 30
X_SQUARED = 40

; Exercise 1
; Produces a table of X, X**2 and X**3 for X=1.0, 1.1, 1.2, 1.3, 1.4, 1.5

; Constants/Variables
;
; 10 = X
; 20 = loop increment (const)
; 30 = loop terminator (const)
; 40 = X**2 destination

==tape

#1

; Clear stores
CLEAR 09
CLEAR X
CLEAR INCREMENT
CLEAR LIMIT
CLEAR X_SQUARED

; Add in data
ADD 01 X
+10000000
ADD 01 INCREMENT
+01000000
ADD 01 LIMIT
+15500000

; Transfer to other tape
SEARCH 2 02
TRANSFER-CONTROL 02


==tape

#2

; Calc X, X^2
ADD X X_SQUARED
MULTIPLY X X_SQUARED

; Print X
PRINT-LAYOUT-1
ADD X 01

; Print X**2
ADD 09 01

; Copy X**2 to 40, clear accumulator and calc X**3
ADD 09 X_SQUARED
CLEAR 09
MULTIPLY X X_SQUARED

; Print X**3
PRINT-LAYOUT-2
ADD 09 01

; Increase X
ADD INCREMENT X

; Test
ADD LIMIT X_SQUARED
SUBTRACT X X_SQUARED
TEST-POSITIVE X_SQUARED

CLEAR X_SQUARED
CLEAR 09

; Search for block 2 again or stop
SEARCH-IF 2 02
FINISH
