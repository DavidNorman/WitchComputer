; Approximate pi using the first five terms of the Leibniz series:
;
;   pi = 4 * (1 - 1/3 + 1/5 - 1/7 + 1/9 ...)

ONE = 10
DENOMINATOR = 20
QUOTIENT = 30
SUM = 40
FOUR = 60

==tape

#1

CLEAR 09
CLEAR ONE
CLEAR DENOMINATOR
CLEAR QUOTIENT
CLEAR SUM
CLEAR FOUR

ADD 01 ONE
+10000000
ADD 01 FOUR
+40000000

; +1/1
ADD 01 DENOMINATOR
+10000000
ADD ONE 09
DIVIDE DENOMINATOR QUOTIENT
ADD-AND-CLEAR QUOTIENT SUM
CLEAR 09

; -1/3
CLEAR DENOMINATOR
ADD 01 DENOMINATOR
+30000000
ADD ONE 09
DIVIDE DENOMINATOR QUOTIENT
SUBTRACT-AND-CLEAR QUOTIENT SUM
CLEAR 09

; +1/5
CLEAR DENOMINATOR
ADD 01 DENOMINATOR
+50000000
ADD ONE 09
DIVIDE DENOMINATOR QUOTIENT
ADD-AND-CLEAR QUOTIENT SUM
CLEAR 09

; -1/7
CLEAR DENOMINATOR
ADD 01 DENOMINATOR
+70000000
ADD ONE 09
DIVIDE DENOMINATOR QUOTIENT
SUBTRACT-AND-CLEAR QUOTIENT SUM
CLEAR 09

; +1/9
CLEAR DENOMINATOR
ADD 01 DENOMINATOR
+90000000
ADD ONE 09
DIVIDE DENOMINATOR QUOTIENT
ADD-AND-CLEAR QUOTIENT SUM
CLEAR 09

; Multiply the partial sum by four and print the accumulator
MULTIPLY SUM FOUR
PRINT-LAYOUT-2
ADD 09 01
FINISH
